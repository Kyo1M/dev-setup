# ~/.gitconfig から [include] で読む。user.name / user.email は ~/.gitconfig 側に置く。
[core]
	pager = delta
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = OneHalfDark
	hyperlinks = true
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
